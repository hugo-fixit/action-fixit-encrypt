{
  "name": "action-fixit-encrypt",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "type": "commonjs",
  "main": "dist/index.cjs",
  "description": "GitHub Action for fixit-encrypt — Setup fixit-encrypt to encrypt your FixIt Hugo site content.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/index.cjs",
    "lint": "eslint src/",
    "preversion": "pnpm typecheck && pnpm build",
    "postversion": "pnpm release",
    "release": "auto-changelog-plus"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/io": "^3.0.0",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "auto-changelog-plus": "^1.3.0",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
